# Backend base URL used by the Vite dev proxy (see vite.config.js).
# The browser always calls same-origin `/api/*`; Vite forwards it here.
#
# This app only uses the Identity service, which serves /api/identity/v1/* directly.
#   - Direct to Identity (default, works when only identity+db are up):  http://localhost:8001
#   - Via the API gateway (if you run it):                              http://localhost:8000
API_URL=http://localhost:8001
